# Строка подключения PostgreSQL (Settings → Database → Connection string → URI)
# Нужна для автоматического создания таблицы cart_items (npm run migrate:cart)
DATABASE_URL=

PORT=3000

SUPABASE_URL=https://ваш-проект.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ваш-service-role-key

JWT_SECRET=придумайте-длинную-случайную-строку-минимум-32-символа

# Email администраторов через запятую (полный доступ + выдача ролей)
ADMIN_EMAILS=admin@example.com

# Email продавцов через запятую (если колонка role ещё не добавлена в БД)
SELLER_EMAILS=

# Сброс пароля по email (опционально; без SMTP — ссылка в консоли сервера / devResetLink)
FRONTEND_URL=https://krivetochkin.github.io/RKVP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# RESET_LINK_IN_RESPONSE=true
